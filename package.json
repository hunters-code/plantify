{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "plantify",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "husky"
  },
  "type": "module",
  "workspaces": [
    "src/plantify_frontend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3"
  },
  "lint-staged": {
    "src/plantify_apps/**/*.{js,jsx,ts,tsx}": [
      "cd src/plantify_apps && eslint --fix --max-warnings=0",
      "cd src/plantify_apps && prettier --write"
    ],
    "src/plantify_apps/**/*.{json,css,scss,md}": [
      "cd src/plantify_apps && prettier --write"
    ],
    "src/plantify_apps/**/*.{ts,tsx}": [
      "cd src/plantify_apps && npm run type-check:staged"
    ],
    "src/plantify_admin/**/*.{js,jsx,ts,tsx}": [
      "cd src/plantify_admin && eslint --fix --max-warnings=0",
      "cd src/plantify_admin && prettier --write"
    ],
    "src/plantify_admin/**/*.{json,css,scss,md}": [
      "cd src/plantify_admin && prettier --write"
    ],
    "src/plantify_frontend/**/*.{js,jsx,ts,tsx}": [
      "cd src/plantify_frontend && eslint --fix --max-warnings=0",
      "cd src/plantify_frontend && prettier --write"
    ],
    "src/plantify_frontend/**/*.{json,css,scss,md}": [
      "cd src/plantify_frontend && prettier --write"
    ]
  }
}
